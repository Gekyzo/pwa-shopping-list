{
  "name": "shopping",
  "version": "1.13.1",
  "description": "Shopping list app with an active list and a next list, recipes, a weekly menu, synced and shared lists, AI item entry, purchase history and a pantry",
  "private": true,
  "type": "module",
  "imports": {
    "#ds/*": "./design-system/*.js",
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "node --test",
    "test:features": "node --test --test-reporter=spec tests/features.test.js",
    "serve": "python3 -m http.server 8080",
    "pair": "node scripts/pair.mjs",
    "icons": "node scripts/make-icons.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs"
  }
}
