{
  "name": "shopping",
  "version": "1.13.8",
  "description": "Offline shopping list PWA with one list for the trip, recipes, a weekly menu, shops and store sections, and lists synced and shared through a Google account",
  "private": true,
  "type": "module",
  "imports": {
    "#ds/*": "./design-system/*.js",
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "node --test",
    "test:features": "node --test --test-reporter=spec tests/features.test.js",
    "serve": "python3 -m http.server 8080",
    "pair": "node scripts/pair.mjs",
    "icons": "node scripts/make-icons.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs",
    "apk": "node scripts/apk.mjs"
  }
}
