{
  "name": "shopping",
  "version": "1.4.1",
  "description": "Shopping list app with an active list and a next list, recipes, a weekly menu, synced and shared lists, AI item entry, purchase history and a pantry",
  "private": true,
  "type": "module",
  "imports": {
    "#ds/*": "./vendor/design-system/*.js",
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8080",
    "icons": "node scripts/make-icons.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs",
    "ds": "node ../pwa-design-system/sync.mjs"
  }
}
